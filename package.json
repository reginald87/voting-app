{
  "name": "bmu-vote",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "sync:face-api": "node -e \"const fs=require('fs');const s=require.resolve('@vladmandic/face-api/dist/face-api.js');fs.mkdirSync('public',{recursive:true});fs.copyFileSync(s,'public/face-api.js');console.log('Synced public/face-api.js from',s);\"",
    "postinstall": "prisma generate && npm run sync:face-api"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@vladmandic/face-api": "^1.7.14",
    "bcryptjs": "^2.4.3",
    "iconv-lite": "^0.7.3",
    "next": "14.2.15",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
