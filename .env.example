# ---------------------------------------------------------------------------
# BMU-Vote environment variables
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# SQLite dev database (relative to prisma/)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# SMTP email (used to send OTP verification codes).
# The app supports up to FOUR providers (SMTP_HOST, SMTP_HOST2, SMTP_HOST3,
# SMTP_HOST4) with automatic fallback: it tries SMTP_HOST first and moves to
# the next on failure/rate-limit.
#
# FREE-TIER FACTS (June 2026) — do NOT rely on one provider:
#   Brevo       300 emails/day        smtp-relay.brevo.com:587
#   SMTP2GO     200 emails/day        mail.smtp2go.com:587   (1000/mo; 25/hr
#                                          until you verify the sender domain)
#   Resend      100 emails/day        smtp.resend.com:587
#   MailerSend  100 emails/day        smtp.mailersend.net:587   (500/mo)
#
# Stacking all four covers ~700 emails/day for free. Because day-one login
# volume can exceed that, ALSO use the admin "Issue code" feature: an
# electoral officer generates the OTP for a voter and relays it by phone /
# WhatsApp, so voting is never blocked by a provider cap.
#
# IMPORTANT: every sender domain must be verified with each provider
# (SPF/DKIM). Use a domain you own (e.g. bmu-sug.edu.ng); Gmail/Yahoo
# recipients are most likely to receive from a properly authenticated domain.
# Use the provider's SMTP login/password (not the API key).
# ---------------------------------------------------------------------------
SMTP_HOST="smtp-relay.brevo.com"        # primary: 300/day
SMTP_PORT=587
SMTP_USER="your-brevo-smtp-login"
SMTP_PASS="your-brevo-smtp-password"
SMTP_FROM="BMU SUG Elections <no-reply@bmu-sug.edu.ng>"

SMTP_HOST2="mail.smtp2go.com"           # fallback 2: 200/day
SMTP_PORT2=587
SMTP_USER2="your-smtp2go-username"
SMTP_PASS2="your-smtp2go-password"
SMTP_FROM2="BMU SUG Elections <no-reply@bmu-sug.edu.ng>"

SMTP_HOST3="smtp.resend.com"            # fallback 3: 100/day
SMTP_PORT3=587
SMTP_USER3="resend"
SMTP_PASS3="re_xxxxxxxx"
SMTP_FROM3="BMU SUG Elections <no-reply@bmu-sug.edu.ng>"

SMTP_HOST4="smtp.mailersend.net"        # fallback 4: 100/day (500/mo)
SMTP_PORT4=587
SMTP_USER4="MSP_xxxxxxxx"
SMTP_PASS4="your-mailersend-smtp-password"
SMTP_FROM4="BMU SUG Elections <no-reply@bmu-sug.edu.ng>"

# ---------------------------------------------------------------------------
# Admin session signing. Use a long random value in production.
# ---------------------------------------------------------------------------
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Biometric template encryption key. Used to encrypt face descriptors at rest
# (AES-256-GCM). If unset it falls back to SESSION_SECRET. Set a distinct long
# value on the VPS before enabling face mode, and do not rotate it afterwards.
# ---------------------------------------------------------------------------
BIOMETRIC_KEY="change-me-to-another-long-random-string"
