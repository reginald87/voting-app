# ---------------------------------------------------------------------------
# BMU-Vote environment variables
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# SQLite dev database (relative to prisma/)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# SMTP email (used to send OTP verification codes).
# The app supports TWO providers with automatic fallback:
#   SMTP_HOST  (primary)   -> if it fails/slow, it falls back to SMTP_HOST2.
#
# SCALE NOTE: With 1000+ voters, only voters NOT yet face-enrolled need an
# email (their one-time enrollment OTP + resends). If most aren't enrolled,
# day-one volume can exceed ~2000 emails. Match the provider to that:
#
#   RECOMMENDED (primary): MailerSend  ~12,000/month free
#       smtp.mailersend.net:587   (login: MSP_xxx, password: your SMTP pass)
#   Fallback: Brevo  ~300/day free
#       smtp-relay.brevo.com:587
#   Others: Resend ~3k/mo, Mailgun ~100/day, SendGrid ~100/day,
#           Amazon SES ~62k/mo free (some regions, needs domain + warmup).
#
# Use the provider's SMTP login/password (not the API key) unless the provider
# explicitly exposes a single API token for SMTP.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.mailersend.net"
SMTP_PORT=587
SMTP_USER="MSP_xxxxxxxx"
SMTP_PASS="your-mailersend-smtp-password"
SMTP_FROM="BMU SUG Elections <no-reply@your-domain.com>"

# Optional fallback provider (used automatically when the first is down/slow):
SMTP_HOST2="smtp-relay.brevo.com"
SMTP_PORT2=587
SMTP_USER2="your-smtp-login"
SMTP_PASS2="your-smtp-password"
SMTP_FROM2="BMU SUG Elections <no-reply@your-domain.com>"

# ---------------------------------------------------------------------------
# Admin session signing. Use a long random value in production.
# ---------------------------------------------------------------------------
SESSION_SECRET="change-me-to-a-long-random-string"
